  "residents.count": {
    "zh-TW": "{count} 位",
    "en": "{count} neighbours",
    "pattern": "^(\\d+)\\s*位$",
    "params": [
      "count"
    ]
  },
  "residents.chat_title": {
    "zh-TW": "和 {name} 聊聊",
    "en": "Chat with {name}",
    "pattern": "^和 (.+) 聊聊$",
    "params": [
      "name"
    ]
  },
  "residents.chat_page_title": {
    "zh-TW": "和 {name} 聊聊｜熊熊 Atlas",
    "en": "Chat with {name} | Bear Atlas",
    "pattern": "^和 (.+) 聊聊｜熊熊 Atlas$",
    "params": [
      "name"
    ]
  },
  "residents.back": {
    "zh-TW": "← 回{place}的居民",
    "en": "← Back to the neighbours in {place}",
    "pattern": "^← 回(.+)的居民$",
    "params": [
      "place"
    ]
  },
  "pagination.page": {
    "zh-TW": "第 {current} / {total} 頁",
    "en": "Page {current} / {total}",
    "pattern": "^第 (\\d+) / (\\d+) 頁$",
    "params": [
      "current",
      "total"
    ]
  },
  "guide.step": {
    "zh-TW": "第 {current} 步，共 {total} 步",
    "en": "Step {current} of {total}",
    "pattern": "^第 (\\d+) 步，共 (\\d+) 步$",
    "params": [
      "current",
      "total"
    ]
  },
  "cottage.owner_suffix": {
    "zh-TW": "的小屋",
    "en": "'s Cozy Cottage",
    "pattern": "^\\s*的小屋$",
    "params": []
  },
  "cottage.bedroom_suffix": {
    "zh-TW": "的臥室",
    "en": "'s Bedroom",
    "pattern": "^\\s*的臥室$",
    "params": []
  },
  "passport.owner_suffix": {
    "zh-TW": "的護照",
    "en": "'s Passport",
    "pattern": "^\\s*的護照$",
    "params": []
  },
  "memories.owner_suffix": {
    "zh-TW": "的島嶼紀念冊",
    "en": "'s Island Memories",
    "pattern": "^\\s*的島嶼紀念冊$",
    "params": []
  },
  "golf.direction_label": {
    "zh-TW": "方向（0° 指向球洞）",
    "en": "Direction (0° points toward the hole)"
  }
